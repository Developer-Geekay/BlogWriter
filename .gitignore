# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Secrets — never commit these
.env
.env.local
.env.*.local

# Test / coverage output
coverage/
.vitest/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# NOTE: package-lock.json is deliberately NOT ignored. CI installs with
# `npm ci`, which requires a committed lockfile for reproducible builds.
