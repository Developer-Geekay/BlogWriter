# Copy to .env for local runs. In production these come from your host's
# environment or secret manager. .env is gitignored — never commit real values.

# ---------------------------------------------------------------- required ---

# MongoDB connection string. Local server, Docker, or an Atlas cluster.
#   local:  mongodb://127.0.0.1:27017/blog
#   atlas:  mongodb+srv://user:pass@cluster.mongodb.net/blog
MONGODB_URI=mongodb://127.0.0.1:27017/blog

# Optional: database name, when the URI has no path segment.
# MONGODB_DB=blog

# Signs the admin session cookie. At least 32 characters; a weak value makes
# the cookie forgeable. Generate with: openssl rand -hex 32
SESSION_SECRET=

# ---------------------------------------------------------------- optional ---

# Public origin, used for canonical links and the MCP endpoint shown in
# Settings. Falls back to the request host when unset.
# SITE_URL=https://example.com

# Analytics. Tenant ("site") IDs come from the analytics dashboard. Nothing is
# tracked until one is set, so a fresh clone is silent by default.
#
# Set both and the right one is used automatically: a production build reports
# under the production tenant, `npm run dev` under the development one. That way
# one file can hold both without local page loads landing in the real numbers.
# NEXT_PUBLIC_ANALYTICS_SITE_ID_PRODUCTION=
# NEXT_PUBLIC_ANALYTICS_SITE_ID_DEVELOPMENT=
#
# Single-value form — wins over the pair above. For a staging deployment, or if
# you only ever build one environment from this machine.
# NEXT_PUBLIC_ANALYTICS_SITE_ID=
#
# The analytics server. Defaults to https://analytics.consoleapi.in; only set
# this to point at a different one.
# NEXT_PUBLIC_ANALYTICS_HOST=
#
# NOTE: NEXT_PUBLIC_* values are inlined into the browser bundle at build time,
# so they must be present when `npm run build` runs, not just at startup.

# LinkedIn cross-posting. Populated by: npm run cli linkedin:auth
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_PERSON_URN=

# NOTE: the MCP endpoint's on/off switch and bearer token are NOT set here.
# They live in the database and are managed in the portal at /admin/settings,
# so they can be changed without a redeploy.
