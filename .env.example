# Copy to .env for local runs. In production these come from your host's
# environment or secret manager. .env is gitignored — never commit real values.

# ---------------------------------------------------------------- required ---

# MongoDB connection string. Local server, Docker, or an Atlas cluster.
#   local:  mongodb://127.0.0.1:27017/hotpath
#   atlas:  mongodb+srv://user:pass@cluster.mongodb.net/hotpath
MONGODB_URI=mongodb://127.0.0.1:27017/hotpath

# Optional: database name, when the URI has no path segment.
# MONGODB_DB=hotpath

# Signs the admin session cookie. At least 32 characters; a weak value makes
# the cookie forgeable. Generate with: openssl rand -hex 32
SESSION_SECRET=

# ---------------------------------------------------------------- optional ---

# Public origin, used for canonical links and the MCP endpoint shown in
# Settings. Falls back to the request host when unset.
# SITE_URL=https://example.com

# Enables "Draft with AI" in the portal. Without it that button reports the
# feature as unavailable; everything else works.
# ANTHROPIC_API_KEY=sk-ant-...

# LinkedIn cross-posting. Populated by: npm run cli linkedin:auth
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_PERSON_URN=

# NOTE: the MCP endpoint's on/off switch and bearer token are NOT set here.
# They live in the database and are managed in the portal at /admin/settings,
# so they can be changed without a redeploy.
