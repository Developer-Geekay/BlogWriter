# Copy to .env for local runs. In CI these live in GitHub Secrets.
# .env is gitignored — never commit real values.

# Required for drafting (phase 1).
ANTHROPIC_API_KEY=sk-ant-...

# Required for publishing to gokulakannan.dev (phase 3).
# Must match API_SECRET_KEY on the server. Generate with: openssl rand -hex 32
WEBSITE_API_TOKEN=

# Required for LinkedIn (phase 4). Populated by `npm run cli linkedin:auth`.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
